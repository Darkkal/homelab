[Unit]
Description=KoboldCPP AI Inference
After=network-online.target

[Container]
Image=ghcr.io/lostruins/koboldcpp:latest
ContainerName=koboldcpp
Network=ai-rig.network
AddDevice=nvidia.com/gpu=all
Volume=/path/to/your/models:/models:Z
Exec=--model /models/gemma-4-26b-a4b-q3_k_m.gguf --routermode --admin --admindir /models --autounload 600 --gpulayers 99 --contextsize 32768 --port 5001 --host 0.0.0.0

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
