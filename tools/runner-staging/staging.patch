diff --git a/act/container/docker/staging_path_test.go b/act/container/docker/staging_path_test.go
new file mode 100644
index 0000000..e7ef401
--- /dev/null
+++ b/act/container/docker/staging_path_test.go
@@ -0,0 +1,68 @@
+package docker
+
+import (
+	"archive/tar"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	actcontainer "code.forgejo.org/forgejo/runner/v13/act/container"
+	"github.com/moby/moby/client"
+	"github.com/stretchr/testify/mock"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStagingCopyDirUsesConfinedRunPaths(t *testing.T) {
+	ext := &LinuxContainerEnvironmentExtensions{endpoint: &endpoint{arch: "amd64"}}
+	require.Equal(t, "/run", ext.GetRoot())
+	require.Equal(t, "/run/act", ext.GetActPath())
+	require.Equal(t, filepath.Join(ext.GetRoot(), "act"), ext.GetActPath())
+	require.Equal(t, "/tmp", ext.GetRunnerContext(t.Context())["temp"])
+	require.True(t, ext.SupportsDockerContainerActions())
+	for _, action := range []string{"checkout", "cache"} {
+		t.Run(action, func(t *testing.T) {
+			src, fs := t.TempDir(), t.TempDir()
+			require.NoError(t, os.WriteFile(filepath.Join(src, ".eslintignore"), []byte("fixture"), 0o644))
+			require.NoError(t, os.Mkdir(filepath.Join(src, "dist"), 0o755))
+			require.NoError(t, os.WriteFile(filepath.Join(src, "dist/index.js"), []byte("fixture"), 0o644))
+			dest := ext.GetActPath() + "/actions/" + action + "/"
+			require.NoError(t, os.MkdirAll(filepath.Join(fs, dest, "dist"), 0o755))
+			require.NoError(t, os.Mkdir(filepath.Join(fs, "var"), 0o755))
+			require.NoError(t, os.Symlink("/run", filepath.Join(fs, "var/run")))
+			root, err := os.OpenRoot(fs)
+			require.NoError(t, err)
+			defer root.Close()
+			// Preserve confinement: the old absolute symlink and escapes must fail.
+			for _, name := range []string{"var/run/act", "../outside", "/run/act"} {
+				_, err := root.Lstat(name)
+				require.Error(t, err)
+			}
+			cli := &mockDockerClient{}
+			cli.On("CopyToContainer", t.Context(), "fixture", mock.Anything).
+				Run(func(args mock.Arguments) {
+					opts := args.Get(2).(client.CopyToContainerOptions)
+					require.Equal(t, "/", opts.DestinationPath)
+					seen := map[string]bool{}
+					tr := tar.NewReader(opts.Content)
+					for {
+						h, err := tr.Next()
+						if err == io.EOF {
+							break
+						}
+						require.NoError(t, err)
+						require.True(t, strings.HasPrefix(h.Name, "run/act/actions/"+action+"/"), h.Name)
+						_, err = root.Lstat(filepath.Dir(h.Name))
+						require.NoError(t, err)
+						seen[h.Name] = true
+					}
+					require.True(t, seen["run/act/actions/"+action+"/.eslintignore"])
+					require.True(t, seen["run/act/actions/"+action+"/dist/index.js"])
+				}).Return(client.CopyToContainerResult{}, nil).Once()
+			cr := &containerReference{id: "fixture", cli: cli, input: &actcontainer.NewContainerInput{}}
+			require.NoError(t, cr.CopyDir(dest, src+"/", false)(t.Context()))
+			cli.AssertExpectations(t)
+		})
+	}
+}
