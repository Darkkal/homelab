diff --git a/act/runner/staging_path_test.go b/act/runner/staging_path_test.go
new file mode 100644
index 0000000..a0adfe6
--- /dev/null
+++ b/act/runner/staging_path_test.go
@@ -0,0 +1,30 @@
+package runner
+
+import (
+	"path/filepath"
+	"testing"
+
+	"code.forgejo.org/forgejo/runner/v13/act/model"
+	"github.com/stretchr/testify/require"
+)
+
+func TestStagingMountAndRemoteActionPaths(t *testing.T) {
+	ctx := t.Context()
+	rc := &RunContext{Config: &Config{
+		Workdir: "/work/project", ActionCacheDir: "/cache/actions",
+		ContainerDaemonSocket: "/fixture/podman.sock", ValidVolumes: []string{"/fixture/job-ca.pem"},
+	}, Run: &model.Run{Workflow: &model.Workflow{Name: "fixture"}}, JobContainer: &containerMock{}}
+	binds, mounts, valid, err := rc.GetBindsAndMounts(ctx)
+	require.NoError(t, err)
+	require.Equal(t, "/run/act", mounts[rc.getInternalVolumeEnv(ctx)])
+	require.Equal(t, "/work/project", mounts[rc.getInternalVolumeWorkdir(ctx)])
+	require.Contains(t, binds, "/fixture/podman.sock:/var/run/docker.sock")
+	require.Contains(t, valid, "/fixture/job-ca.pem")
+	require.Equal(t, "/cache/actions", rc.ActionCacheDir())
+	for _, action := range []string{"checkout", "cache"} {
+		step := &model.Step{Uses: "https://data.forgejo.org/actions/" + action + "@v4"}
+		name, dest := getContainerActionPaths(step, filepath.Join(rc.ActionCacheDir(), action), rc)
+		require.Equal(t, action, name)
+		require.Equal(t, "/run/act/actions/"+action, dest)
+	}
+}
