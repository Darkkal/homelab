[Unit]
Description=Caddy Local Routing Proxy
Requires=koboldcpp.service sillytavern.service piclaw.service
After=koboldcpp.service sillytavern.service piclaw.service

[Container]
Image=docker.io/library/caddy:latest
ContainerName=caddy
Network=${NETWORK_NAME}
PublishPort=80:80
Volume=/path/to/caddy/Caddyfile:/etc/caddy/Caddyfile:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
