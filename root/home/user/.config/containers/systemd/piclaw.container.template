[Unit]
Description=PiClaw Agent Workspace
After=network-online.target

[Container]
Image=ghcr.io/rcarmo/piclaw:latest
ContainerName=piclaw
Network=${NETWORK_NAME}
# Environment variables use this syntax
Environment=PICLAW_WEB_PORT=8080
# Quadlets handle init natively via systemd, but we can pass the flag to podman
RunInit=true
Volume=${PICLAW_HOME_DIR}:/config:Z
Volume=${PICLAW_WORKSPACE_DIR}:/workspace:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
