[Unit]
Description=Publish %I via mDNS
Requires=avahi-daemon.service
After=avahi-daemon.service network-online.target

[Service]
Type=simple
# Dynamically grabs your machine's LAN IP and binds the alias to it
ExecStart=/bin/bash -c "exec /usr/bin/avahi-publish -a -R %I $$(hostname -I | cut -d' ' -f1)"
Restart=on-failure

[Install]
WantedBy=multi-user.target
