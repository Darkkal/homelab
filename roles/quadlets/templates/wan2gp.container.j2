[Unit]
Description=Wan2GP Video Generation Web Interface
After=network-online.target wan2gp-build.service
Wants=wan2gp-build.service

[Container]
ContainerName=wan2gp
Image={{ wan2gp_image | default('localhost/wan2gp:latest') }}
AutoUpdate={{ wan2gp_autoupdate | default('local') }}
Network={{ network_name }}
PublishPort={{ wan2gp_port | default(7860) }}:7860

AddDevice=nvidia.com/gpu=all
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/ckpts:/workspace/ckpts:Z
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/loras:/workspace/loras:Z
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/outputs:/workspace/outputs:Z
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/settings:/workspace/settings:Z
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/profiles:/workspace/profiles:Z
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/plugins:/workspace/plugins:Z
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}/finetunes:/workspace/finetunes:Z

Label=homepage.group="Inference"
Label=homepage.name=Wan2GP
Label=homepage.icon=mdi-movie-open
Label=homepage.href=http://wan2gp.local
Label=homepage.description="Video generation"

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
