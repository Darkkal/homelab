[Unit]
Description=Wan2GP Video Generation Web Interface
After=network-online.target wan2gp-build.service
Wants=wan2gp-build.service

[Container]
ContainerName=wan2gp
Image={{ wan2gp_image | default('localhost/wan2gp:latest') }}
Network={{ network_name }}
PublishPort={{ wan2gp_port | default(7860) }}:7860

AddDevice=nvidia.com/gpu=all
Volume={{ wan2gp_data_dir | default(homelab_data_dir + '/wan2gp') }}:/workspace:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
