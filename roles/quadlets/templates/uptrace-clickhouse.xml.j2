<clickhouse>
    <!-- Listen on all interfaces so Uptrace/collector can reach the container
         over the homelab.network bridge (default is loopback-only). -->
    <listen_host>0.0.0.0</listen_host>
    <listen_host>::</listen_host>
    <listen_try>1</listen_try>

    <!-- Expose Prometheus metrics for the Uptrace collector to scrape. -->
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
        <status_info>true</status_info>
    </prometheus>
</clickhouse>
