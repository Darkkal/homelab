[Unit]
Description=Hatchet PostgreSQL storage, queue and pubsub
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
ContainerName=hatchet-postgres
Image={{ hatchet_postgres_image }}
AutoUpdate={{ hatchet_postgres_autoupdate | default('registry') }}
Network={{ network_name }}
UserNS=keep-id:uid=999,gid=999
User=999
Group=999
NoNewPrivileges=true
DropCapability=all
Environment=POSTGRES_DB=hatchet
Environment=POSTGRES_USER=hatchet
Environment=POSTGRES_PASSWORD_FILE=/run/hatchet-postgres-password
Environment=PGDATA=/var/lib/postgresql/data/pgdata
Environment=TZ=UTC
Volume={{ hatchet_data_dir }}/pg:/var/lib/postgresql/data:Z
Volume={{ hatchet_data_dir }}/postgres-password:/run/hatchet-postgres-password:ro,Z
HealthCmd=pg_isready -U hatchet -d hatchet
HealthInterval=10s
HealthStartPeriod=30s
HealthRetries=6
LogDriver=none

[Service]
Restart=on-failure
RestartSec=10
TimeoutStopSec=60

[Install]
WantedBy=default.target
