[Unit]
Description=Forgejo Git Service
After=network-online.target

[Container]
ContainerName=forgejo
Image=codeberg.org/forgejo/forgejo:10
Network={{ network_name }}
Environment=USER_UID=1000
Environment=USER_GID=1000
Environment=FORGEJO__server__ROOT_URL=http://forgejo.local/
Environment=FORGEJO__server__DOMAIN=forgejo.local
Environment=FORGEJO__server__HTTP_PORT={{ forgejo_port | default(3003) }}
Environment=FORGEJO__server__SSH_PORT=222
Environment=FORGEJO__server__SSH_DOMAIN=forgejo.local
{% if forgejo_admin_user is defined and forgejo_admin_user %}
Environment=FORGEJO_ADMIN_USER={{ forgejo_admin_user }}
{% endif %}
{% if forgejo_admin_password is defined and forgejo_admin_password %}
Environment=FORGEJO_ADMIN_PASSWORD={{ forgejo_admin_password }}
{% endif %}
{% if forgejo_admin_email is defined and forgejo_admin_email %}
Environment=FORGEJO_ADMIN_EMAIL={{ forgejo_admin_email }}
{% endif %}
PublishPort={{ forgejo_port | default(3003) }}:{{ forgejo_port | default(3003) }}
PublishPort=222:22
Volume={{ forgejo_data_dir }}:/data:Z

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
