# -- DATA CONFIGURATION --
dataRoot: ./data
# -- SERVER CONFIGURATION --
listen: true
listenAddress:
  ipv4: 0.0.0.0
  ipv6: '[::]'
protocol:
  ipv4: true
  ipv6: false
port: 8000
# -- SECURITY CONFIGURATION --
whitelistMode: false
basicAuthMode: false
# LAN-only deployment fronted by Caddy HTTPS; skip SillyTavern's
# non-localhost security alert that would otherwise exit the server.
securityOverride: true
