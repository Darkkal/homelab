[Unit]
Description=Open WebUI Chat Frontend
After=network-online.target

[Container]
ContainerName=open-webui
Image=ghcr.io/open-webui/open-webui:main
AutoUpdate={{ openwebui_autoupdate | default('registry') }}
Network={{ network_name }}
Environment=PORT={{ openwebui_port | default(8081) }}
Environment=OPENAI_API_BASE_URL={{ openwebui_openai_api_base_url | default('http://llama-swap:8080/v1') }}
Environment=OPENAI_API_BASE_URLS={{ openwebui_openai_api_base_urls | default('http://llama-swap:8080/v1') }}
Environment=OPENAI_API_KEY={{ openwebui_openai_api_key | default('sk-dummy') }}
Environment=OPENAI_API_KEYS={{ openwebui_openai_api_keys | default('sk-dummy') }}
Environment=ENABLE_RAG_WEB_SEARCH={{ openwebui_enable_web_search | default(true) | lower }}
Environment=RAG_WEB_SEARCH_ENGINE={{ openwebui_web_search_engine | default('searxng') }}
Environment=SEARXNG_QUERY_URL={{ openwebui_searxng_query_url | default('http://searxng:8080/search?q=<query>') }}
Environment=WEB_LOADER_ENGINE={{ openwebui_web_loader_engine | default('playwright') }}
Environment=PLAYWRIGHT_WS_URI={{ openwebui_playwright_ws_uri | default('ws://playwright:3000') }}
PublishPort={{ openwebui_port | default(8081) }}:{{ openwebui_port | default(8081) }}
Volume={{ openwebui_data_dir }}:/app/backend/data:Z

Label=homepage.group="Web Services"
Label=homepage.name="Open WebUI"
Label=homepage.icon=open-webui.png
Label=homepage.href=https://openwebui.home
Label=homepage.description="Chat & RAG frontend"

[Service]
Restart=always

[Install]
WantedBy=default.target
