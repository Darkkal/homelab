[Unit]
Description=llama-swap Model Proxy & Inference Server
After=network-online.target

[Container]
Image=ghcr.io/mostlygeek/llama-swap:unified-cuda
AutoUpdate={{ llama_swap_autoupdate | default('registry') }}
ContainerName=llama-swap
Network={{ network_name }}
PublishPort={{ llama_swap_port | default(8080) }}:8080
AddDevice=nvidia.com/gpu=all
Volume={{ model_dir }}:/models:Z
Volume={{ llama_swap_config_dir | default(homelab_data_dir + '/llama-swap') }}/config.yaml:/etc/llama-swap/config/config.yaml:Z

Label=homepage.group="Inference"
Label=homepage.name=llama-swap
Label=homepage.icon=mdi-swap-horizontal-bold
Label=homepage.href=https://llamaswap.home
Label=homepage.description="LLM model swap & inference proxy"

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
