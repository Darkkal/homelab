- Inference:
    - llama-swap:
        href: http://llamaswap.local
        icon: mdi-swap-horizontal-bold
        description: LLM model swap & inference proxy
        siteMonitor: http://llama-swap:8080
    - SwarmUI:
        href: http://swarmui.local
        icon: mdi-image-multiple
        description: Image generation
        siteMonitor: http://swarmui:7801
    - Wan2GP:
        href: http://wan2gp.local
        icon: mdi-movie-open
        description: Video generation
        siteMonitor: http://wan2gp:7860

- Apps:
    - SillyTavern:
        href: http://sillytavern.local
        icon: sillytavern.png
        description: LLM roleplay chat
        siteMonitor: http://sillytavern:8000
    - Open WebUI:
        href: http://openwebui.local
        icon: open-webui.png
        description: Chat & RAG frontend
        siteMonitor: http://open-webui:8081
    - Hermes Agent:
        href: http://hermes.local
        icon: hermes-icon.png
        description: Agent platform
        siteMonitor: http://hermes:9119

- Infrastructure:
    - Forgejo:
        href: http://forgejo.local
        icon: forgejo.png
        description: Git hosting
        siteMonitor: http://forgejo:3003
        {% if forgejo_api_token %}
        widget:
          type: gitea
          url: http://forgejo:3003
          key: {{ forgejo_api_token }}
        {% endif %}
    - Caddy:
        href: http://localhost:80
        icon: caddy.png
        description: Reverse proxy
        siteMonitor: http://caddy:80
    - Homepage:
        href: http://homepage.local
        icon: homepage.png
        description: This dashboard
        siteMonitor: http://homepage:3000
