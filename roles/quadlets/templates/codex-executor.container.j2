[Unit]
Description=Codex executor {{ item.instance }}
ConditionPathExists=!{{ codex_executor_data_dir }}/instances/{{ item.instance }}/config/.updating
Requires=codex-executor.build
After=codex-executor.build
StartLimitIntervalSec=300
StartLimitBurst=3

[Container]
ContainerName=codex-executor-{{ item.instance }}
Image=codex-executor.build
AutoUpdate=local
Network={{ network_name }}
HttpProxy=false
NoNewPrivileges=true
Volume={{ codex_executor_data_dir }}/instances/{{ item.instance }}/config:/etc/codex-executor:ro,Z
Volume={{ codex_executor_data_dir }}/instances/{{ item.instance }}/control:/var/lib/codex-executor:Z
Volume={{ codex_executor_data_dir }}/instances/{{ item.instance }}/agent:/var/lib/codex-agent:Z
PodmanArgs=--memory={{ item.memory }} --pids-limit={{ item.pids }}
Entrypoint=/usr/bin/env
Exec=-i PATH=/usr/local/bin:/usr/bin:/bin HOME=/nonexistent LANG=C.UTF-8 /opt/executor/node /opt/executor/worker.mjs worker
LogDriver=journald

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=default.target
