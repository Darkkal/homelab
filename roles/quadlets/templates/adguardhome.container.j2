[Unit]
Description=AdGuard Home DNS Server & Ad Blocker
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/adguard/adguardhome:latest
AutoUpdate={{ adguardhome_autoupdate | default('registry') }}
ContainerName=adguardhome
# Run on the host network so AdGuard binds the host LAN IP directly (DNS on
# 192.168.0.5:53). Publishing DNS as a port-published container conflicts with
# aardvark-dns on the podman bridge gateway (10.89.9.1:53) in rootless podman.
# The web UI is served directly on host port {{ adguardhome_port | default(8090) }}.
Network=host
Volume={{ adguardhome_data_dir }}/conf:/opt/adguardhome/conf:Z
Volume={{ adguardhome_data_dir }}/work:/opt/adguardhome/work:Z

Label=homepage.group="Infrastructure"
Label=homepage.name="AdGuard Home"
Label=homepage.icon=adguard-home.png
Label=homepage.href=http://{{ ansible_default_ipv4.address if (ansible_default_ipv4 is defined and ansible_default_ipv4.address is defined) else 'localhost' }}:{{ adguardhome_port | default(8090) }}
Label=homepage.description="Local DNS server & ad blocker"

[Service]
Restart=always

[Install]
WantedBy=default.target