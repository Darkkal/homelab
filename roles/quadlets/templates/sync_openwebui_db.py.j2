#!/usr/bin/env python3
import json
import os
import sqlite3

db_path = "{{ openwebui_data_dir }}/webui.db"

if not os.path.exists(db_path):
    print("Open WebUI database does not exist yet. Skipping database sync.")
    exit(0)

conn = sqlite3.connect(db_path)
cur = conn.cursor()

# Verify config table exists
table_check = cur.execute(
    "SELECT name FROM sqlite_master WHERE type='table' AND name='config'"
).fetchone()

if not table_check:
    print("Config table does not exist in Open WebUI database yet. Skipping.")
    conn.close()
    exit(0)

# Target configurations to sync
base_urls = "{{ openwebui_openai_api_base_urls | default('http://llama-swap:8080/v1') }}".split(";")
api_keys = "{{ openwebui_openai_api_keys | default('sk-dummy') }}".split(";")
api_configs = {
    str(i): {
        "enable": True,
        "tags": [],
        "prefix_id": "",
        "model_ids": [],
        "connection_type": "external",
        "auth_type": "bearer",
        "passthrough_params": [],
    }
    for i in range(len(base_urls))
}

desired_config = {
    "openai.api_base_urls": json.dumps(base_urls),
    "openai.api_keys": json.dumps(api_keys),
    "openai.api_configs": json.dumps(api_configs),
    "web.search.enable": "true",
    "web.search.engine": json.dumps("{{ openwebui_web_search_engine | default('searxng') }}"),
    "web.search.searxng_query_url": json.dumps("{{ openwebui_searxng_query_url | default('http://searxng:8080/search?q=<query>') }}"),
    "web.loader.engine": json.dumps("{{ openwebui_web_loader_engine | default('playwright') }}"),
    "web.loader.playwright_ws_url": json.dumps("{{ openwebui_playwright_ws_uri | default('ws://playwright:3000') }}"),
}

changes_made = 0
for key, desired_val in desired_config.items():
    cur_val = cur.execute("SELECT value FROM config WHERE key = ?", (key,)).fetchone()
    if cur_val is None or str(cur_val[0]) != str(desired_val):
        cur.execute("INSERT OR REPLACE INTO config (key, value) VALUES (?, ?)", (key, desired_val))
        changes_made += 1

if changes_made > 0:
    conn.commit()
    conn.close()
    print(f"Updated {changes_made} configuration keys in Open WebUI SQLite database.")
else:
    conn.close()
    print("No changes needed. SQLite database is already up to date.")
