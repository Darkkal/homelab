(function () {
  const hostname = window.location.hostname;
  if (hostname.endsWith('.{{ lan_domain }}')) {
    return;
  }

  const servicePorts = {
    'sillytavern.{{ lan_domain }}': {{ sillytavern_port | default(8000) }},
    'llamaswap.{{ lan_domain }}': {{ llama_swap_port | default(8080) }},
    'openwebui.{{ lan_domain }}': {{ openwebui_port | default(8081) }},
    'swarmui.{{ lan_domain }}': {{ swarmui_port | default(7801) }},
    'forgejo.{{ lan_domain }}': {{ forgejo_port | default(3003) }},
    'homepage.{{ lan_domain }}': {{ homepage_port | default(3002) }},
    'glances.{{ lan_domain }}': {{ glances_port | default(61208) }},
    'searxng.{{ lan_domain }}': {{ searxng_port | default(8082) }},
    'piclaw.{{ lan_domain }}': {{ piclaw_port | default(8083) }},
    'uptrace.{{ lan_domain }}': {{ uptrace_port | default(14318) }},
    'adguard.{{ lan_domain }}': {{ adguardhome_port | default(8090) }},
  };

  const origin = window.location.protocol + '//' + hostname;

  const rewrite = function (root) {
    root.querySelectorAll('a[href]').forEach(function (anchor) {
      const href = anchor.getAttribute('href');
      if (!href) {
        return;
      }
      let url;
      try {
        url = new URL(href, window.location.href);
      } catch (e) {
        return;
      }
      if (!url.hostname.endsWith('.{{ lan_domain }}')) {
        return;
      }
      const port = servicePorts[url.hostname];
      if (!port) {
        return;
      }
      const rewritten = origin + ':' + port + url.pathname + url.search + url.hash;
      if (anchor.getAttribute('href') !== rewritten) {
        anchor.setAttribute('href', rewritten);
      }
    });
  };

  rewrite(document);

  const observer = new MutationObserver(function () {
    rewrite(document);
  });
  observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });
  window.setTimeout(function () { rewrite(document); }, 1000);
  window.setTimeout(function () { rewrite(document); }, 3000);
})();
