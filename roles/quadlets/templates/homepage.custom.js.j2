(function () {
  const hostname = window.location.hostname;
  if (hostname.endsWith('.local')) {
    return;
  }

  const servicePorts = {
    'sillytavern.local': {{ sillytavern_port | default(8000) }},
    'llamaswap.local': {{ llama_swap_port | default(8080) }},
    'openwebui.local': {{ openwebui_port | default(8081) }},
    'swarmui.local': {{ swarmui_port | default(7801) }},
    'forgejo.local': {{ forgejo_port | default(3003) }},
    'homepage.local': {{ homepage_port | default(3002) }},
    'glances.local': {{ glances_port | default(61208) }},
    'searxng.local': {{ searxng_port | default(8082) }},
    'piclaw.local': {{ piclaw_port | default(8083) }},
  };

  const origin = window.location.protocol + '//' + hostname;

  const rewrite = function (root) {
    root.querySelectorAll('a[href]').forEach(function (anchor) {
      const href = anchor.getAttribute('href');
      if (!href) {
        return;
      }
      let url;
      try {
        url = new URL(href, window.location.href);
      } catch (e) {
        return;
      }
      if (!url.hostname.endsWith('.local')) {
        return;
      }
      const port = servicePorts[url.hostname];
      if (!port) {
        return;
      }
      const rewritten = origin + ':' + port + url.pathname + url.search + url.hash;
      if (anchor.getAttribute('href') !== rewritten) {
        anchor.setAttribute('href', rewritten);
      }
    });
  };

  rewrite(document);

  const observer = new MutationObserver(function () {
    rewrite(document);
  });
  observer.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['href'] });
  window.setTimeout(function () { rewrite(document); }, 1000);
  window.setTimeout(function () { rewrite(document); }, 3000);
})();
