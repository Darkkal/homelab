[Unit]
Description=SearXNG Search Aggregator
After=network-online.target

[Container]
ContainerName=searxng
Image=docker.io/searxng/searxng:latest
AutoUpdate={{ searxng_autoupdate | default('registry') }}
Network={{ network_name }}
Environment=SEARXNG_BASE_URL=https://searxng.home/
Environment=UWSGI_WORKERS=4
Environment=UWSGI_THREADS=4
PublishPort={{ searxng_port | default(8082) }}:8080
Volume={{ searxng_data_dir }}:/etc/searxng:Z

Label=homepage.group="Web Services"
Label=homepage.name="SearXNG"
Label=homepage.icon=searxng.png
Label=homepage.href=https://searxng.home
Label=homepage.description="Self-hosted search aggregator"

[Service]
Restart=always

[Install]
WantedBy=default.target
