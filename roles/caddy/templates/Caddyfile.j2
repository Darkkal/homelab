# Automatic HTTPS is enabled for all sites below (no scheme in the site address).
# Local-only names (*.{{ lan_domain }}) are served certificates from Caddy's internal CA
# (see https://caddyserver.com/docs/automatic-https#local-https), and HTTP is
# redirected to HTTPS automatically.
{
    local_certs
    skip_install_trust
}

sillytavern.{{ lan_domain }} {
    reverse_proxy {{ sillytavern_upstream }}
}

forgejo.{{ lan_domain }} {
    reverse_proxy {{ forgejo_upstream }}
}

llamaswap.{{ lan_domain }} {
    reverse_proxy {{ llama_swap_upstream }}
}

openwebui.{{ lan_domain }} {
    reverse_proxy {{ openwebui_upstream }}
}

swarmui.{{ lan_domain }} {
    reverse_proxy {{ swarmui_upstream }}
}

homepage.{{ lan_domain }} {
    reverse_proxy {{ homepage_upstream }}
}

glances.{{ lan_domain }} {
    reverse_proxy {{ glances_upstream }}
}

searxng.{{ lan_domain }} {
    reverse_proxy {{ searxng_upstream }}
}

piclaw.{{ lan_domain }} {
    reverse_proxy {{ piclaw_upstream }}
}

uptrace.{{ lan_domain }} {
    reverse_proxy {{ uptrace_upstream }}
}

webgallery.{{ lan_domain }} {
    reverse_proxy {{ webgallery_upstream }}
}

hatchet.{{ lan_domain }} {
{% if (hatchet_webhook_body_limit_enabled | default(false)) is sameas true %}
    @hatchet_webhook path /api/v1/stable/tenants/*/webhooks/*
    request_body @hatchet_webhook {
        max_size 1048576
    }
{% endif %}
    reverse_proxy {{ hatchet_upstream }}
}
