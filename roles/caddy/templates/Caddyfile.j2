# Automatic HTTPS is enabled for all sites below (no scheme in the site address).
# Local-only names (*.local) are served certificates from Caddy's internal CA
# (see https://caddyserver.com/docs/automatic-https#local-https), and HTTP is
# redirected to HTTPS automatically.
{
    local_certs
    skip_install_trust
}

sillytavern.local {
    reverse_proxy {{ sillytavern_upstream }}
}

forgejo.local {
    reverse_proxy {{ forgejo_upstream }}
}

